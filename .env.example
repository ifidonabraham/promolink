# ---------------------------------------------------------------------------
# PromoLink Print Concepts — environment variables
# Copy to .env.local for local development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Optional. Without these the site builds and works exactly as normal — quote
# requests and newsletter sign-ups are logged instead of persisted.
# See lib/leads.ts and the SQL in README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for canonical URLs, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://promolink.ng